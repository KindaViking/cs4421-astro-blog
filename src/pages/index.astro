---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import EpicEarth from '../components/EpicEarth.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hello, Major Tom!</h1>
			<p>
            Welcome to my space devlog. I'm a software engineering student writing
        about the rovers and technology that explore other worlds, from
        Sojourner's first drive on Mars to the software that keeps modern
        missions running. This blog is also a practice project: built with
        Astro, tracked in Git, and developed through feature branches and pull
        requests as I go.
			</p>
            <EpicEarth />
			<hr class="divider" />

			<h2>Latest posts</h2>
			<ul class="post-list">
				{
					posts.slice(0, 5).map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="post-date">
								{post.data.pubDate.toLocaleDateString('en-us', {
									year: 'numeric',
									month: 'short',
									day: 'numeric',
								})}
							</span>
						</li>
					))
				}
			</ul>
			<p><a href="/blog">See all posts →</a></p>
		</main>
		<Footer />
	</body>
</html>
